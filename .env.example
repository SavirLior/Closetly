# PostgreSQL / Prisma production data store
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/closetly?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/closetly?schema=public"

# App authentication. Sites uses signed, server-provided identity headers.
AUTH_SECRET="replace-with-at-least-32-random-characters"
DEMO_MODE="true"

# AI provider: demo | openai | custom
AI_PROVIDER="demo"
OPENAI_API_KEY=""
AI_VISION_MODEL="gpt-5-mini"
AI_OUTFIT_MODEL="gpt-5-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="closetly-wardrobe"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Optional providers. The app gracefully falls back when unset.
BACKGROUND_REMOVAL_PROVIDER="none"
BACKGROUND_REMOVAL_API_KEY=""
WEATHER_PROVIDER="none"
WEATHER_API_KEY=""
