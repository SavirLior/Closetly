generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum WardrobeCategory {
  TOPS
  BOTTOMS
  OUTERWEAR
  SHOES
  ACCESSORIES
}

enum OutfitFeedbackType {
  LOVE
  DISLIKE
}

enum OutfitItemRole {
  TOP
  BOTTOM
  OUTERWEAR
  SHOES
  ACCESSORY
}

enum AnalysisStatus {
  PENDING
  ANALYZED
  CONFIRMED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  preferences   UserPreferences?
  wardrobeItems WardrobeItem[]
  outfits       Outfit[]
  feedback      OutfitFeedback[]
  savedOutfits  SavedOutfit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  preferredStyles    String[] @default([])
  dislikedStyles     String[] @default([])
  favoriteColors     String[] @default([])
  dislikedColors     String[] @default([])
  preferredFits      String[] @default([])
  preferredFormality Int      @default(5)
  favoriteCategories String[] @default([])
  learnedScores      Json     @default("{}")
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WardrobeItem {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  category           WardrobeCategory
  subcategory        String
  primaryColor       String
  secondaryColors    String[]          @default([])
  pattern            String?
  patternConfidence  Float?
  material           String?
  materialConfidence Float?
  fit                String?
  fitConfidence      Float?
  styles             String[]          @default([])
  seasons            String[]          @default([])
  formality          Int
  description        String?
  favorite           Boolean           @default(false)
  analysisStatus     AnalysisStatus     @default(PENDING)
  analysisRaw        Json?
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  images             WardrobeItemImage[]
  outfitItems        OutfitItem[]
  savedOutfitItems   SavedOutfitItem[]

  @@index([userId, category])
  @@index([userId, favorite])
  @@index([userId, createdAt])
  @@index([primaryColor])
}

model WardrobeItemImage {
  id             String       @id @default(cuid())
  wardrobeItemId String
  objectKey      String       @unique
  url            String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  isPrimary      Boolean      @default(false)
  backgroundRemoved Boolean   @default(false)
  createdAt      DateTime     @default(now())
  wardrobeItem   WardrobeItem @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)

  @@index([wardrobeItemId, isPrimary])
}

model Outfit {
  id                 String   @id @default(cuid())
  userId             String
  prompt             String
  occasion           String?
  style              String?
  formality          Int?
  season             String?
  weatherSnapshot    Json?
  compatibilityScore Float
  scoreBreakdown     Json?
  explanation        String
  provider           String?
  model              String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              OutfitItem[]
  feedback           OutfitFeedback[]
  savedAs            SavedOutfit[]

  @@index([userId, createdAt])
  @@index([userId, occasion])
}

model OutfitItem {
  outfitId       String
  wardrobeItemId String
  role            OutfitItemRole
  position        Int            @default(0)
  locked          Boolean        @default(false)
  outfit          Outfit         @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  wardrobeItem    WardrobeItem    @relation(fields: [wardrobeItemId], references: [id], onDelete: Restrict)

  @@id([outfitId, wardrobeItemId])
  @@index([wardrobeItemId])
}

model OutfitFeedback {
  id        String             @id @default(cuid())
  outfitId  String
  userId    String
  type      OutfitFeedbackType
  reason    String?
  itemId    String?
  createdAt DateTime           @default(now())
  outfit    Outfit             @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([outfitId])
}

model SavedOutfit {
  id             String   @id @default(cuid())
  userId         String
  sourceOutfitId String?
  title          String
  favorite       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceOutfit   Outfit?  @relation(fields: [sourceOutfitId], references: [id], onDelete: SetNull)
  items          SavedOutfitItem[]

  @@index([userId, createdAt])
  @@index([userId, favorite])
}

model SavedOutfitItem {
  savedOutfitId  String
  wardrobeItemId String
  role           OutfitItemRole
  position       Int             @default(0)
  savedOutfit    SavedOutfit     @relation(fields: [savedOutfitId], references: [id], onDelete: Cascade)
  wardrobeItem   WardrobeItem    @relation(fields: [wardrobeItemId], references: [id], onDelete: Restrict)

  @@id([savedOutfitId, wardrobeItemId])
  @@index([wardrobeItemId])
}
